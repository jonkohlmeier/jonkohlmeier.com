---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Contact Jon Kohlmeier · Puffs of Smoke"
  description="Start a conversation with Jon Kohlmeier."
>
  <div class="contact-page container-page">
    <header>
      <p class="eyebrow">Contact</p>
      <h1>Say hello.</h1>
      <p class="page-header__lede">
        If something here made you think of a question, a story, or an idea of your own, I’d be glad to hear it.
      </p>
    </header>

    <div class="contact-details">
      <div>
        <p class="footer-label">The easiest way</p>
        <h2>Send a note on LinkedIn.</h2>
        <p>
          I usually reply within a couple of days—sometimes with a resource, sometimes with a question, and sometimes
          simply to keep the conversation going.
        </p>
        <a class="button-link" href="https://www.linkedin.com/in/jonkohlmeier/" target="_blank" rel="noopener noreferrer">
          Message Jon on LinkedIn
        </a>
      </div>

      <div class="contact-links">
        <p class="footer-label">Elsewhere</p>
        <a href="https://github.com/jonkohlmeier" target="_blank" rel="noopener noreferrer"><span>GitHub</span><span>↗</span></a>
        <a href="https://www.instagram.com/jon.kohlmeier/" target="_blank" rel="noopener noreferrer"><span>Instagram</span><span>↗</span></a>
        <a href="https://www.facebook.com/jon.kohlmeier" target="_blank" rel="noopener noreferrer"><span>Facebook</span><span>↗</span></a>
        <a href="https://twistoflemonpod.com" target="_blank" rel="noopener noreferrer"><span>Life with a Twist of Lemon</span><span>↗</span></a>
      </div>
    </div>
  </div>
</SiteLayout>
