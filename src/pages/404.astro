---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found · Puffs of Smoke" description="The requested page could not be found.">
  <header class="page-header container-page">
    <p class="eyebrow">404</p>
    <h1>That page isn’t here.</h1>
    <p class="page-header__lede">It may have moved, or the address may be incomplete. The writing archive is a good place to begin again.</p>
    <p style="margin-top: 2rem;"><a class="button-link" href="/writing/">Browse the writing</a></p>
  </header>
</SiteLayout>
