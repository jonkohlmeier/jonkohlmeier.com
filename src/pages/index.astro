---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PostPreviewCard from '../components/PostPreviewCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Portrait from '../assets/jon-reading.jpeg';
import { SITE_DESCRIPTION } from '../consts';
import { articlePath, getCategory, getFormatLabel, sortPosts } from '../data/editorial';

const posts = sortPosts((await getCollection('blog')).filter((post) => !post.data.draft));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const recentPosts = posts.filter((post) => post.id !== featured?.id).slice(0, 5);
const featuredCategory = featured ? getCategory(featured.data.category) : undefined;
---

<SiteLayout
  title="Puffs of Smoke · Ideas worth sitting with"
  description={SITE_DESCRIPTION}
>
  <section class="home-intro container-page">
    <div class="home-intro__heading">
      <p class="eyebrow">Puffs of Smoke</p>
      <h1>Ideas worth<br />sitting with.</h1>
    </div>
    <div class="home-intro__copy">
      <p class="home-intro__lede">I work at the intersection of people, technology, and business.</p>
      <p>
        But that’s hardly all I think about. This is where I write about work, faith, family, good drinks, and whatever
        else has my attention.
      </p>
      <a class="text-link" href="/about/">A little more about me <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {featured && featuredCategory && (
    <section class="section container-page" aria-labelledby="featured-heading">
      <div class="section-heading section-heading--rule">
        <p class="eyebrow">Featured writing</p>
        <a href="/writing/">Browse all writing <span aria-hidden="true">→</span></a>
      </div>
      <article class="featured-story">
        {featured.data.heroImage && (
          <a class="featured-story__image" href={articlePath(featured)} tabindex="-1" aria-hidden="true">
            <Image
              src={featured.data.heroImage}
              alt=""
              widths={[640, 960, 1280]}
              sizes="(min-width: 960px) 52vw, 100vw"
              loading="eager"
            />
          </a>
        )}
        <div class="featured-story__content">
          <div class="article-meta">
            <span>{featuredCategory.label}</span>
            <span aria-hidden="true">·</span>
            <span>{getFormatLabel(featured.data.format)}</span>
          </div>
          <h2 id="featured-heading"><a href={articlePath(featured)}>{featured.data.title}</a></h2>
          <p>{featured.data.description}</p>
          <div class="featured-story__footer">
            <FormattedDate date={featured.data.pubDate} />
            <a class="text-link" href={articlePath(featured)}>Read the piece <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>
    </section>
  )}

  <section class="section section--tinted" aria-labelledby="recent-heading">
    <div class="container-page">
      <div class="section-heading">
        <div>
          <p class="eyebrow">From the archive</p>
          <h2 id="recent-heading">More writing</h2>
        </div>
        <p>Practical, personal, and occasionally just curious.</p>
      </div>
      <div class="article-list">
        {recentPosts.map((post) => <PostPreviewCard post={post} />)}
      </div>
      <div class="section-action"><a class="button-link" href="/writing/">Explore the full archive</a></div>
    </div>
  </section>

  <section class="author-note container-page">
    <Image src={Portrait} alt="Jon Kohlmeier reading in his study" width={300} height={300} />
    <div>
      <p class="eyebrow">About the author</p>
      <h2>A little about the fellow behind the writing.</h2>
      <p>
        I’m Jon. I work in Revenue Operations, live in Iowa with my wife and daughter, and have a habit of developing
        interests I don’t have enough time for.
      </p>
      <a class="text-link" href="/about/">Meet Jon <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
