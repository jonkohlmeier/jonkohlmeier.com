---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { articlePath, getCategory, getFormatLabel } from '../data/editorial';
import SiteLayout from './SiteLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  slug: string;
  newerPost?: CollectionEntry<'blog'>;
  olderPost?: CollectionEntry<'blog'>;
};

const {
  slug,
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroAlt,
  category: categorySlug,
  format,
  archive,
  canonical,
  newerPost,
  olderPost,
} = Astro.props;
const category = getCategory(categorySlug);
---

<SiteLayout
  title={`${title} · Puffs of Smoke`}
  description={description}
  image={heroImage}
  canonical={canonical ?? `/blog/${slug}/`}
  type="article"
  pubDate={pubDate}
>
  <article class="article-page">
    <header class="article-header container-article">
      <a class="article-back" href="/writing/">← Back to writing</a>
      <div class="article-meta">
        <a href={`/writing/?category=${category.slug}`}>{category.label}</a>
        <span aria-hidden="true">·</span>
        <span>{getFormatLabel(format)}</span>
        {archive && (
          <>
            <span aria-hidden="true">·</span>
            <span class="article-meta__archive">From the Archive</span>
          </>
        )}
      </div>
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      <div class="article-date">
        <span>Published <FormattedDate date={pubDate} /></span>
        {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
      </div>
    </header>

    {heroImage && (
      <figure class="article-hero container-wide">
        <Image
          src={heroImage}
          alt={heroAlt ?? ''}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 960px) 960px, 100vw"
        />
        {heroAlt && <figcaption>{heroAlt}</figcaption>}
      </figure>
    )}

    <div class="prose container-article">
      <slot />
    </div>

    <footer class="article-footer container-article">
      <div class="article-adjacent">
        {olderPost ? (
          <a href={articlePath(olderPost)}>
            <span>Older</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        ) : <span></span>}
        {newerPost && (
          <a class="article-adjacent__newer" href={articlePath(newerPost)}>
            <span>Newer</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        )}
      </div>
      <a class="button-link" href="/writing/">Return to the full archive</a>
    </footer>
  </article>
</SiteLayout>
