---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { articlePath, getCategory } from '../data/editorial';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const category = getCategory(post.data.category);
---

<article
  class="article-row"
  data-testid="post-card"
  data-article
  data-category={category.slug}
>
  <div class="article-row__content">
    <div class="article-meta">
      <FormattedDate date={post.data.pubDate} />
      <span aria-hidden="true">·</span>
      <span>{category.label}</span>
      {post.data.archive && (
        <>
          <span aria-hidden="true">·</span>
          <span class="article-meta__archive">From the Archive</span>
        </>
      )}
    </div>
    <h3><a href={articlePath(post)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
  </div>
</article>
