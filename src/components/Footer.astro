---
import { NAV_LINKS } from '../data/navigation';
import { SOCIAL_LINKS } from '../data/social';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-page site-footer__main">
    <div>
      <a class="site-footer__title" href="/">Puffs of Smoke</a>
      <p>Come for an idea. Stay for the perspective.</p>
      <p class="site-footer__byline">Written and published by Jon Kohlmeier in Cedar Rapids, Iowa.</p>
    </div>

    <nav aria-label="Footer navigation">
      <p class="footer-label">Read</p>
      {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <nav aria-label="Elsewhere">
      <p class="footer-label">Elsewhere</p>
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith('/') ? undefined : '_blank'}
          rel={link.url.startsWith('/') ? undefined : 'noopener noreferrer'}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
  <div class="container-page site-footer__bottom">
    <p>© {year} Jon Kohlmeier.</p>
    <div class="site-footer__utility">
      <a href="/privacy/">Privacy</a>
      <button type="button" data-analytics-manage>Manage cookies</button>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>
